{
  "name": "@socialgouv/cdtn-utils",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "version": "4.250.1",
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SocialGouv/code-du-travail-numerique.git",
    "directory": "packages/code-du-travail-utils"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.ts\"",
    "format": "prettier --write \"./src/**/*.ts\"",
    "format:check": "prettier --check \"./src/**/*.ts\"",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "~19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.ts": [
      "pnpm lint --fix --quiet",
      "pnpm format"
    ]
  }
}
